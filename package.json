{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "description": "A neighborhood tool-lending board with automated n8n workflows.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=public --project=signed-in",
    "test:n8n": "playwright test --project=n8n",
    "e2e:users": "node scripts/create-test-users.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:grant": "node scripts/grant-admin.mjs",
    "secrets:setup": "node scripts/setup-secrets.mjs",
    "n8n:setup": "node scripts/n8n-setup.mjs",
    "n8n:check": "node scripts/check-n8n-exports.mjs",
    "n8n:remind-now": "node scripts/n8n-remind-now.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.23",
    "@convex-dev/rate-limiter": "0.4.3",
    "@hookform/resolvers": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.49.0",
    "convex-helpers": "0.1.133",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@clerk/testing": "2.2.53",
    "@convex-dev/eslint-plugin": "5.0.1",
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "convex-test": "0.0.66",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
