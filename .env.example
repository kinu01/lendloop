# Next.js app (.env.local). Names only; never commit values.

# Written by `npm run dev:backend` for the local Convex backend.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# From the Clerk dashboard (API keys page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stops Clerk from creating a temporary app when keys are missing.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# Convex deployment variables. Set these with `npx convex env set NAME value`,
# not in this file.
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL (the session token issuer)
# N8N_WEBHOOK_URL           n8n request-notification webhook URL
# CONVEX_TO_N8N_SECRET      signs requests from Convex to n8n
# N8N_TO_CONVEX_SECRET      verifies requests from n8n to Convex
# ALLOW_DEMO_SEED           set to true to allow the demo seed (local only)

# Test users for the signed-in browser tests. Written by `npm run e2e:users`.
E2E_CLERK_OWNER_EMAIL=
E2E_CLERK_BORROWER_EMAIL=
E2E_CLERK_ADMIN_EMAIL=
